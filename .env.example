# ---------------------------------------------------------------------------
# Peckers Sauce Management System — environment
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used by the seed script, the daily digest and
# admin user management. Must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=re_your_api_key
# Must be a verified sender on your Resend account.
RESEND_FROM_EMAIL="Peckers SMS <sms@yourdomain.co.uk>"

# --- App -------------------------------------------------------------------
# Single business timezone. All "today", "expiring today" and "next prep day"
# maths resolves through this.
NEXT_PUBLIC_APP_TIMEZONE=Europe/London

# Public base URL, used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the daily digest endpoint. The Supabase scheduled Edge
# Function sends this as `Authorization: Bearer <secret>`.
CRON_SECRET=generate-a-long-random-string

# --- Vitamojo gross sales ----------------------------------------------------
# The dashboard shows each store's gross sales for the last closed day, read
# from the peckers-VM-dashboard app (it scrapes VM Hub nightly at 00:30 UK into
# its own Supabase and serves GET /api/sauce/daily-net-sales — that route
# returns gross_sales despite the name). VITAMOJO_API_SECRET must equal
# SAUCE_API_KEY over there. Leave both unset to hide the figures — nothing else
# on the dashboard depends on them.
VITAMOJO_API_URL=https://peckers-vm-dashboard.onrender.com
VITAMOJO_API_SECRET=must-match-sauce-api-key-in-peckers-vm-dashboard

# --- Seeding -----------------------------------------------------------------
# `npm run db:seed` (reference data: sites/sauces/par levels) needs none of these.
#
# `npm run db:create-manager` — your first real production login. Pass these as
# one-off shell variables rather than storing them here, e.g.:
#   MANAGER_EMAIL=you@peckers.co.uk MANAGER_NAME="Your Name" MANAGER_PASSWORD='...' npm run db:create-manager
#
# `npm run db:seed:demo` — DEV/STAGING ONLY, fake users + 6 weeks of fake usage.
# Requires SEED_DEMO_PASSWORD (8+ chars) set explicitly; there is no default.
#   SEED_DEMO_PASSWORD='...' npm run db:seed:demo
